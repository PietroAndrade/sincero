{
  "name": "sincero-protobuf-typescript",
  "private": true,
  "type": "module",
  "description": "Experiment: using backend/proto/sincero/simulation_input.proto from TypeScript",
  "scripts": {
    "generate": "buf generate ../../../../backend/proto --template buf.gen.yaml && npm run generate:rules",
    "generate:rules": "protoc -I../proto --descriptor_set_in=../../../../backend/proto/buf_validate.binpb --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=src/gen \"--es_opt=target=ts,rewrite_imports=./buf/validate/*_pb.js:@bufbuild/protovalidate/gen\" sincero_rules.proto",
    "build": "tsc -p tsconfig.json",
    "experiment": "npm run build && node dist/experiment.js && node dist/rules.js",
    "test": "npm run build && node --test dist/test.js"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protobuf": "^2.6.0",
    "@bufbuild/protoc-gen-es": "^2.6.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
