<Project Sdk="Microsoft.NET.Sdk">
  <!-- Experiment: using backend/proto/sincero/simulation_input.proto from C#.
       Code generation is part of the build: Grpc.Tools runs protoc (bundled in the package) on
       every <Protobuf> item — no protoc on PATH, no separate generate step, no Python. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sincero.Experiment</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.69.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../../../backend/proto/sincero/simulation_input.proto"
              ProtoRoot="../../../../../backend/proto" GrpcServices="None" />
  </ItemGroup>
</Project>
