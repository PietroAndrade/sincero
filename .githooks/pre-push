#!/usr/bin/env bash
# Blocks direct pushes to develop/master (they go through a GitHub PR, squash-merged)
# and runs the full test suite before any other push.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
run_tests=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/develop|refs/heads/master)
      echo "pre-push: direct push to ${remote_ref#refs/heads/} is blocked. Open a PR and squash-merge it on GitHub." >&2
      exit 1
      ;;
  esac
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    run_tests=1
  fi
done

[ "$run_tests" -eq 1 ] || exit 0

venv="$root/backend/.venv/bin"
if [ ! -x "$venv/python" ]; then
  echo "pre-push: backend/.venv not found. Run: python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements-dev.txt" >&2
  exit 1
fi

cd "$root/backend"
PATH="$venv:$PATH" make test >/dev/null || {
  echo "pre-push: make test failed. Run it from backend/ to see the output." >&2
  exit 1
}
